{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jinbbb0.github.io/tft-mobile-overlay-data/schema/manifest.schema.json",
  "title": "TFT Mobile Overlay version manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "setId", "setNumber", "setName", "patch", "revision", "updateKind", "generatedAtUtc", "minimumAppVersionCode", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "setId": { "type": "string", "minLength": 1 },
    "setNumber": { "type": "integer", "minimum": 1 },
    "setName": { "type": "string", "minLength": 1 },
    "patch": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "updateKind": { "enum": ["NEW_SET", "PATCH", "B_PATCH", "META_UPDATE", "E2E_TEST"] },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "sourceTimestampUtc": { "type": "string", "format": "date-time" },
    "metaFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceQueryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "readiness": { "enum": ["CATALOG_READY", "META_COLLECTING", "META_STABLE"] },
    "releaseState": { "enum": ["STABLE", "PARTIAL"] },
    "validationStatus": { "enum": ["PASS", "PARTIAL_PASS"] },
    "sourceAlignment": { "enum": ["VERIFIED", "PARTIAL"] },
    "validatedAtUtc": { "type": "string", "format": "date-time" },
    "featureReadiness": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog", "champions", "traits", "items", "augments", "compositions", "boards", "recommendedItems", "compositionAugments"],
      "properties": {
        "catalog": { "$ref": "#/$defs/featureState" }, "champions": { "$ref": "#/$defs/featureState" }, "traits": { "$ref": "#/$defs/featureState" },
        "items": { "$ref": "#/$defs/featureState" }, "augments": { "$ref": "#/$defs/featureState" }, "compositions": { "$ref": "#/$defs/featureState" },
        "boards": { "$ref": "#/$defs/featureState" }, "recommendedItems": { "$ref": "#/$defs/featureState" }, "compositionAugments": { "$ref": "#/$defs/featureState" }
      }
    },
    "levelBoardReadiness": {
      "type": "object", "additionalProperties": false,
      "required": ["lv4", "lv5", "lv6", "lv7", "lv8", "lv9"],
      "properties": { "lv4": { "$ref": "#/$defs/featureState" }, "lv5": { "$ref": "#/$defs/featureState" }, "lv6": { "$ref": "#/$defs/featureState" }, "lv7": { "$ref": "#/$defs/featureState" }, "lv8": { "$ref": "#/$defs/featureState" }, "lv9": { "$ref": "#/$defs/featureState" } }
    },
    "minimumAppVersionCode": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 1500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "url", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 31457280 }
        }
      }
    }
  },
  "$defs": { "featureState": { "enum": ["READY", "PARTIAL", "COLLECTING", "NOT_PROVIDED", "UNAVAILABLE"] } }
}
