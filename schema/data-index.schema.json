{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jinbbb0.github.io/tft-mobile-overlay-data/schema/data-index.schema.json",
  "title": "TFT Mobile Overlay data index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "latestVersionId", "generatedAtUtc", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "latestVersionId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "setId", "setNumber", "setName", "patch", "revision", "updateKind", "generatedAtUtc", "manifestUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "setId": { "type": "string", "minLength": 1 },
          "setNumber": { "type": "integer", "minimum": 1 },
          "setName": { "type": "string", "minLength": 1 },
          "patch": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "updateKind": { "enum": ["NEW_SET", "PATCH", "B_PATCH", "META_UPDATE", "E2E_TEST"] },
          "generatedAtUtc": { "type": "string", "format": "date-time" },
          "sourceTimestampUtc": { "type": "string", "format": "date-time" },
          "metaFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceQueryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "readiness": { "enum": ["CATALOG_READY", "META_COLLECTING", "META_STABLE"] },
          "manifestUrl": { "type": "string", "pattern": "^bundles/[a-z0-9._-]+/manifest\\.json$" },
          "hidden": { "type": "boolean" }
        }
      }
    }
  }
}
