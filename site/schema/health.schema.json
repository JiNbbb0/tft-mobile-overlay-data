{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jinbbb0.github.io/tft-mobile-overlay-data/schema/health.schema.json",
  "title": "TFT Mobile Overlay data health",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "generatedAt", "latestSetId", "latestPatch", "latestRevision", "versionCount", "fileCount", "workflowRunId", "sourceUpdatedAt"],
  "properties": {
    "status": { "const": "ok" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "latestSetId": { "type": "string", "minLength": 1 },
    "latestPatch": { "type": "string", "minLength": 1 },
    "latestRevision": { "type": "string", "minLength": 1 },
    "versionCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "fileCount": { "type": "integer", "minimum": 1 },
    "workflowRunId": { "type": "string", "minLength": 1 },
    "sourceUpdatedAt": { "type": "string", "format": "date-time" }
  }
}
