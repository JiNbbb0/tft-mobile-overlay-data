{
  "name": "tft-data-watchdog",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "triggers": { "crons": ["2-59/5 * * * *"] },
  "vars": {
    "ENABLED": "false",
    "GITHUB_APP_ID": "5214289",
    "GITHUB_INSTALLATION_ID": "168606955",
    "GITHUB_REPOSITORY": "JiNbbb0/tft-mobile-overlay-data",
    "DATA_INDEX_URL": "https://jinbbb0.github.io/tft-mobile-overlay-data/data-index.json"
  },
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "STATE", "id": "bab69f26bf4046ccbd793d84d5631b85" }
  ]
}
