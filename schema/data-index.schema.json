{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jinbbb0.github.io/tft-mobile-overlay-data/schema/data-index.schema.json",
  "title": "TFT Mobile Overlay data index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "latestVersionId", "generatedAtUtc", "versions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "latestVersionId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "latestStableVersionId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "latestAvailableVersionId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "sourceCheckedAtUtc": { "type": "string", "format": "date-time" },
    "latestObservedSourceTimestampUtc": { "type": "string", "format": "date-time" },
    "freshnessPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warningAfterSeconds", "criticalAfterSeconds"],
      "properties": {
        "warningAfterSeconds": { "const": 21600 },
        "criticalAfterSeconds": { "const": 86400 }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "setId", "setNumber", "setName", "patch", "revision", "updateKind", "generatedAtUtc", "manifestUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "setId": { "type": "string", "minLength": 1 },
          "setNumber": { "type": "integer", "minimum": 1 },
          "setName": { "type": "string", "minLength": 1 },
          "patch": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "updateKind": { "enum": ["NEW_SET", "PATCH", "B_PATCH", "META_UPDATE", "E2E_TEST"] },
          "generatedAtUtc": { "type": "string", "format": "date-time" },
          "sourceTimestampUtc": { "type": "string", "format": "date-time" },
          "metaFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceQueryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "readiness": { "enum": ["CATALOG_READY", "META_COLLECTING", "META_STABLE"] },
          "releaseState": { "enum": ["STABLE", "PARTIAL"] },
          "validationStatus": { "enum": ["PASS", "PARTIAL_PASS"] },
          "sourceAlignment": { "enum": ["VERIFIED", "PARTIAL"] },
          "validatedAtUtc": { "type": "string", "format": "date-time" },
          "featureReadiness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["catalog", "champions", "traits", "items", "augments", "compositions", "boards", "recommendedItems", "compositionAugments"],
            "properties": {
              "catalog": { "$ref": "#/$defs/featureState" }, "champions": { "$ref": "#/$defs/featureState" },
              "traits": { "$ref": "#/$defs/featureState" }, "items": { "$ref": "#/$defs/featureState" },
              "augments": { "$ref": "#/$defs/featureState" }, "compositions": { "$ref": "#/$defs/featureState" },
              "boards": { "$ref": "#/$defs/featureState" }, "recommendedItems": { "$ref": "#/$defs/featureState" },
              "compositionAugments": { "$ref": "#/$defs/featureState" }
            }
          },
          "levelBoardReadiness": {
            "type": "object", "additionalProperties": false,
            "required": ["lv4", "lv5", "lv6", "lv7", "lv8", "lv9"],
            "properties": { "lv4": { "$ref": "#/$defs/featureState" }, "lv5": { "$ref": "#/$defs/featureState" }, "lv6": { "$ref": "#/$defs/featureState" }, "lv7": { "$ref": "#/$defs/featureState" }, "lv8": { "$ref": "#/$defs/featureState" }, "lv9": { "$ref": "#/$defs/featureState" } }
          },
          "manifestUrl": { "type": "string", "pattern": "^bundles/[a-z0-9._-]+/manifest\\.json$" },
          "hidden": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": { "featureState": { "enum": ["READY", "PARTIAL", "COLLECTING", "NOT_PROVIDED", "UNAVAILABLE"] } }
}
